{{ 'section-faq.css' | asset_url |  stylesheet_tag }}

<div class="page-widht faq">
    <h2 class="h1">{{section.settings.headline}}</h2>
</div>

{% for block in section.blocks %}
<div class="faq_row">
    <input type="checkbox" id="question_{{ forloop.index }}" class="faq_toggle">
    <label for="question_{{ forloop.index }}" class="faq_question">{{ block.settings.question }}</label>
    <div class="faq_answer">{{ block.settings.answer }}</div>
</div>
  {% endfor %}

{% schema %}
  {
    "name": "FAQ",
    "tag": "section",
    "settings": [
        {
          "type": "text",
          "id": "headline",
          "label": "titulo"
        }

    ],
    "blocks": [
      {
        "name": "question",
        "type": "question",
        "settings": [
           {
             "type": "text",
             "id": "question",
             "label": "pregunta"
           },
            {
              "type": "text",
              "id": "answer",
              "label": "respuesta"
            }
        ]
      }
    ],
    "presets": [
      {
        "name": "FAQ",
        "settings": {
          
        }
      }
    ]
}
{% endschema %}