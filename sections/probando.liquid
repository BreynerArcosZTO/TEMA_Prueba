{{ 'section-faq.css' | asset_url |  stylesheet_tag }}

<div class="page-widht faq">
    <h2 class="h1">Preguntas frecuentes</h2>
</div>

<div class="faq_row">
    <input type="checkbox" id="pregunta_1" class="faq_toggle">
    <label for="pregunta_1" class="faq_question">Cual es la politica?</label>
    <div class="faq_answer">Los items que desean ser regresados tienen 30 dias para su devolucion. Contactanos</div>
</div>
<div class="faq_row">
    <input type="checkbox" id="pregunta_2" class="faq_toggle">
    <label for="pregunta_2" class="faq_question">Cuanto tarda el envío?</label>
    <div class="faq_answer">El envio tarda hasta 7 dias habiles, segun tu ubicación. Si tienes algun problema contactanos</div>
</div>
<div class="faq_row">
    <input type="checkbox" id="pregunta_3" class="faq_toggle">
    <label for="pregunta_3" class="faq_question">Las ofertas son a nivel internacional?</label>
    <div class="faq_answer">Por supuesto, al igual que los envios. Estos dependen tambien de la transportadora encargada</div>
</div>

{% schema %}
  {
    "name": "FAQ",
    "tag": "section",
    "settings": [
        {
          "type": "text",
          "id": "Titulo",
          "label": "titulo"
        }

    ],
    "blocks": [
      {
        "name": "pregunta",
        "type": "question",
        "settings": [
           {
             "type": "text",
             "id": "question",
             "label": "pregunta"
           },
            {
              "type": "text",
              "id": "answer",
              "label": "respuesta"
            }
        ]
      }
    ],
    "presets": [
      {
        "name": "FAQ",
        "settings": {
          
        }
      }
    ]
}
{% endschema %}